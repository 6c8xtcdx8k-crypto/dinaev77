# --- База данных ---
# Для разработки — SQLite. Для продакшена замените на PostgreSQL,
# поменяв provider в prisma/schema.prisma на "postgresql".
DATABASE_URL="file:./dev.db"

# --- Аутентификация ---
# Секрет для подписи JWT-сессий (обязательно замените в продакшене)
AUTH_SECRET="change-me-in-production"

# --- Email-уведомления ---
# Провайдер: "console" (лог в консоль + файлы в .emails/) или "smtp"
EMAIL_PROVIDER="console"
EMAIL_FROM="Styleberries <noreply@styleberries.example>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Платежи ---
# Провайдер: "mock" (тестовая оплата) | заготовки: "yookassa", "stripe"
PAYMENT_PROVIDER="mock"

# --- Базовый URL сайта (для ссылок в письмах) ---
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
