# --- База данных ---
# Для разработки — SQLite. Для продакшена замените на PostgreSQL,
# поменяв provider в prisma/schema.prisma на "postgresql".
DATABASE_URL="file:./dev.db"

# --- Аутентификация ---
# Секрет для подписи JWT-сессий (обязательно замените в продакшене)
AUTH_SECRET="change-me-in-production"

# --- Email-уведомления ---
# Провайдер: "console" (лог в консоль + файлы в .emails/) или "smtp"
EMAIL_PROVIDER="console"
EMAIL_FROM="Styleberries <noreply@styleberries.example>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Оплата (можно задать один способ или оба) ---
# Кошелёк USDT в сети TRC-20.
PAYMENT_USDT_TRC20=""
# Номер карты для перевода (или номер телефона для перевода по СБП).
# Необязательно: если пусто, покупателю показывается только ссылка/QR.
PAYMENT_CARD=""
# Платёжная ссылка банка для QR карты (ссылка «перевод по QR» из приложения
# банка). Если пусто — используется ссылка Т-Банка, зашитая в src/lib/payment.ts.
PAYMENT_CARD_QR="https://tbank.ru/cf/2lpzxBl3uEn"
# ID чата, куда бот отправляет каждый новый заказ и сигналы об оплате.
# Как узнать: добавьте бота в чат и отправьте туда команду /id.
ORDERS_CHAT_ID=""

# --- Базовый URL сайта (для ссылок в письмах и Telegram Mini App) ---
# Для Telegram обязателен публичный HTTPS-адрес задеплоенного сайта.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Telegram Mini App ---
# Токен бота от @BotFather (/newbot). Без него Telegram-функции выключены.
TELEGRAM_BOT_TOKEN=""
# Произвольная строка — защита webhook от посторонних запросов.
TELEGRAM_WEBHOOK_SECRET=""

# --- Загрузка изображений ---
# Каталог для фото товаров (по умолчанию ./data/uploads; в Docker задан на volume)
UPLOAD_DIR=""

# --- Администратор ---
# Учётка админа создаётся при заполнении базы (db:seed / первый запуск).
# Не задано — демо admin@styleberries.example / admin123 (только для разработки!)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Instagram (необязательно) ---
# Публикация товаров из админки в Instagram: docs/INSTAGRAM.md.
# Нужен аккаунт типа «Бизнес» или «Автор» и приложение на developers.facebook.com.
INSTAGRAM_USER_ID=""
INSTAGRAM_ACCESS_TOKEN=""
